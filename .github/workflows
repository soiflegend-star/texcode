name: Build APK from zip

# Works for any zip at the repo root that contains a Gradle Android project
# (Texwave, TEXCODE, ...). It builds the zip that was committed most recently.

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Extract newest project zip
        run: |
          BEST=""; BEST_T=0
          for z in ./*.zip; do
            [ -f "$z" ] || continue
            t=$(git log -1 --format=%ct -- "$z" 2>/dev/null || echo 0)
            [ -z "$t" ] && t=0
            if [ -z "$BEST" ] || [ "$t" -gt "$BEST_T" ]; then BEST="$z"; BEST_T="$t"; fi
          done
          if [ -z "$BEST" ]; then echo "No zip found at repo root"; exit 1; fi
          echo "Extracting $BEST"
          rm -rf extracted_project
          unzip -q -o "$BEST" -d extracted_project

      - name: Find the Gradle project
        id: proj
        run: |
          GRADLEW=$(find extracted_project -name gradlew -not -path "*/node_modules/*" | head -n 1)
          if [ -z "$GRADLEW" ]; then echo "No gradlew found in the zip"; exit 1; fi
          DIR=$(dirname "$GRADLEW")
          echo "Project directory: $DIR"
          echo "dir=$DIR" >> "$GITHUB_OUTPUT"

      - name: Patch broken gradlew JVM opts
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          sed -i 's/DEFAULT_JVM_OPTS=.*/DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"/' gradlew
          grep -n DEFAULT_JVM_OPTS gradlew

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      # The Android SDK is preinstalled on GitHub runners; just accept its licenses.
      - name: Accept Android SDK licenses
        run: |
          SDKM=$(ls -d "$ANDROID_HOME"/cmdline-tools/*/bin/sdkmanager 2>/dev/null | head -n 1)
          if [ -n "$SDKM" ]; then yes | "$SDKM" --licenses > /dev/null || true; fi

      - uses: gradle/actions/setup-gradle@v3

      - name: Build debug APK
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          chmod +x gradlew
          ./gradlew :app:assembleDebug --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: debug-apk
          path: ${{ steps.proj.outputs.dir }}/app/build/outputs/apk/debug/*.apk
